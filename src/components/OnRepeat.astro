---
const { title = "On repeat", tracks = [] } = Astro.props;
const first = tracks[0];
---
<section class="s-repeat" aria-labelledby="repeat-title" data-repeat>
  <h2 class="h-section" id="repeat-title">{title}</h2>
  <p class="repeat-intro">Every project in this portfolio has its own song. Pick a track to see which one, and press play for a 30-second preview.</p>

  <div class="repeat-body">
    <ol class="repeat-list" aria-label="Projects and their songs">
      {tracks.map((p, i) => (
        <li>
          <button type="button" class="repeat-pick" aria-pressed="false"
                  data-index={i} data-name={p.name} data-song={p.song.title}
                  data-artist={p.song.artist} data-project={p.id}>
            <span class="repeat-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="repeat-name">{p.name}</span>
            <span class="repeat-song">{p.song.title} — {p.song.artist}</span>
          </button>
        </li>
      ))}
    </ol>

    {first && (
      <div class="repeat-now">
        <div class="repeat-cover">
          <img alt="" width="400" height="400" hidden>
          <button type="button" class="repeat-play" aria-pressed="false" hidden>&#9654;&#65038;</button>
        </div>
        <div class="repeat-info">
          <p class="repeat-label">The song of {first.name}</p>
          <p class="repeat-title">{first.song.title}</p>
          <p class="repeat-artist">{first.song.artist}</p>
        </div>
        <a class="repeat-link" href={`#${first.id}-title`}>
          See <span class="repeat-link-name">{first.name}</span> <span aria-hidden="true">&darr;</span>
        </a>
        <p class="repeat-status" role="status" aria-live="polite"></p>
      </div>
    )}
  </div>

  <p class="repeat-credit">Music data and previews: iTunes Search API (Apple).</p>
</section>

<style is:global>
  /* ── Escritorio: la sección va en flujo normal, entre los dos lienzos.
     No tiene alto fijo: mide lo que ocupa su contenido. Usa la misma columna
     que About: 174 de margen a cada lado del lienzo de 1024 = 676 de ancho ── */
  .s-repeat {
    padding: calc(20 * var(--u)) calc(174 * var(--u)) calc(90 * var(--u));
    background: var(--lavender);
    color: var(--ink);
  }

  /* style.css pone display:block a todas las img, y eso le gana al atributo hidden */
  .s-repeat [hidden] { display: none; }

  /* mismo título que "About me" */
  .s-repeat .h-section { margin: 0; }

  /* mismo texto que About */
  .repeat-intro { margin: 0; font-size: calc(16 * var(--u)); }

  /* playlist a la izquierda, canción elegida en una columna angosta a la derecha */
  .repeat-body {
    display: grid;
    grid-template-columns: 1fr calc(220 * var(--u));
    gap: calc(40 * var(--u));
    align-items: start;
    margin-top: calc(32 * var(--u));
  }

  /* tracklist: filas separadas por una línea fina, como en una app de música */
  .repeat-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #495D9440;
  }

  .repeat-list li {
    padding-block: calc(4 * var(--u));
    border-bottom: 1px solid #495D9440;
  }

  /* número a la izquierda (ocupa dos filas), nombre y canción a la derecha */
  .repeat-pick {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: calc(14 * var(--u));
    align-items: baseline;
    width: 100%;
    padding: calc(10 * var(--u)) calc(14 * var(--u));
    border: 0;
    border-radius: calc(10 * var(--u));
    background: transparent;
    color: var(--ink);
    font-family: var(--sans);
    text-align: left;
    cursor: pointer;
  }

  .repeat-pick:hover { background: #FFF2DE99; }

  .repeat-pick[aria-pressed="true"] {
    background: var(--indigo);
    color: var(--cream);
  }

  .repeat-num {
    grid-row: span 2;
    font-family: var(--serif);
    font-size: calc(20 * var(--u));
    color: var(--indigo);
  }

  .repeat-pick[aria-pressed="true"] .repeat-num { color: inherit; }

  .repeat-name {
    font-size: calc(17 * var(--u));
    font-weight: 600;
  }

  .repeat-song {
    grid-column: 2;
    font-size: calc(14 * var(--u));
  }

  .repeat-pick:focus-visible,
  .repeat-play:focus-visible,
  .repeat-link:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .repeat-now {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
  }

  .repeat-cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(12 * var(--u));
    background: var(--cream);
  }

  .repeat-cover img { width: 100%; height: 100%; object-fit: cover; }

  .repeat-play {
    position: absolute;
    right: calc(10 * var(--u));
    bottom: calc(10 * var(--u));
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
    border: 0;
    border-radius: 50%;
    background: var(--cream);
    color: var(--indigo);
    font-size: calc(16 * var(--u));
    cursor: pointer;
  }

  .repeat-play[aria-pressed="true"] {
    background: var(--indigo);
    color: var(--cream);
  }

  .repeat-info {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
  }

  .repeat-label {
    margin: 0;
    font-size: calc(12 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--indigo);
  }

  .repeat-title {
    margin: 0;
    font-family: var(--serif);
    font-size: calc(22 * var(--u));
    line-height: 1.2;
  }

  .repeat-artist {
    margin: 0;
    font-size: calc(15 * var(--u));
  }

  /* acción principal del panel: lleva al proyecto de la canción elegida */
  .repeat-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--u));
    margin-top: calc(4 * var(--u));
    padding: calc(10 * var(--u)) calc(20 * var(--u));
    border-radius: 999px;
    background: var(--indigo);
    color: var(--cream);
    font-size: calc(15 * var(--u));
    font-weight: 600;
    text-decoration: none;
  }

  .repeat-link:hover { background: var(--ink); }

  .repeat-status {
    min-height: calc(22 * var(--u));
    margin: 0;
    font-size: calc(14 * var(--u));
    line-height: 1.4;
  }

  .repeat-status[data-state="error"] { color: #9B2C4A; font-weight: 600; }

  .repeat-credit {
    margin: calc(32 * var(--u)) 0 0;
    font-size: calc(13 * var(--u));
  }

  /* ── Celular: playlist arriba; debajo, la carátula chica al lado del título
     y el botón de ancho completo ── */
  @media (max-width: 899px) {
    /* misma columna máxima de 640 px que las demás secciones (style.css) */
    .s-repeat { padding: 56px max(20px, calc((100% - 640px) / 2)); }
    .repeat-intro { margin-top: 22px; font-size: 16px; }
    .repeat-body { grid-template-columns: 1fr; gap: 24px; margin-top: 24px; }
    .repeat-list li { padding-block: 4px; }
    .repeat-pick { column-gap: 12px; min-height: 48px; padding: 10px 12px; border-radius: 10px; }
    .repeat-num { font-size: 18px; }
    .repeat-name { font-size: 16px; }
    .repeat-song { font-size: 14px; }

    .repeat-now {
      display: grid;
      grid-template-columns: 110px 1fr;
      column-gap: 14px;
      row-gap: 8px;
      align-items: center;
    }
    .repeat-cover { border-radius: 10px; }
    .repeat-play { width: 44px; height: 44px; right: 6px; bottom: 6px; font-size: 15px; }
    .repeat-label { font-size: 12px; }
    .repeat-title { font-size: 20px; }
    .repeat-artist { font-size: 15px; }
    .repeat-link,
    .repeat-status { grid-column: 1 / -1; }
    .repeat-link {
      justify-content: center;
      min-height: 48px;
      gap: 6px;
      margin-top: 4px;
      padding: 12px 20px;
      font-size: 16px;
    }
    .repeat-status { font-size: 15px; min-height: 22px; }
    .repeat-credit { font-size: 12px; margin-top: 24px; }
  }
</style>

<script is:inline>
  (function () {
    "use strict";

    var root = document.querySelector("[data-repeat]");
    if (!root) return;

    var picks = root.querySelectorAll(".repeat-pick");
    if (!picks.length) return;

    var status = root.querySelector(".repeat-status");
    var label = root.querySelector(".repeat-label");
    var songEl = root.querySelector(".repeat-title");
    var artistEl = root.querySelector(".repeat-artist");
    var cover = root.querySelector(".repeat-cover img");
    var playBtn = root.querySelector(".repeat-play");
    var link = root.querySelector(".repeat-link");
    var linkName = root.querySelector(".repeat-link-name");

    var audio = new Audio();
    var playingBtn = null;
    var previewUrl = null; // preview de la canción elegida
    var cache = {};        // resultado de cada track ya pedido (la API limita ~20 pedidos por minuto)
    var token = 0;         // identifica el último pedido, para ignorar respuestas viejas

    var PLAY = "▶︎";
    var PAUSE = "❚❚";

    function setStatus(text, state) {
      status.textContent = text;
      status.setAttribute("data-state", state);
    }

    function stopAudio() {
      audio.pause();
      if (playingBtn) {
        playingBtn.setAttribute("aria-pressed", "false");
        playingBtn.textContent = PLAY;
      }
      playingBtn = null;
    }

    function togglePlay(url, btn) {
      if (playingBtn === btn) {
        stopAudio();
        return;
      }
      stopAudio();
      audio.src = url;
      playingBtn = btn;
      btn.setAttribute("aria-pressed", "true");
      btn.textContent = PAUSE;
      var p = audio.play();
      if (p && p.catch) {
        p.catch(function () {
          stopAudio();
          setStatus("Couldn't play this preview. Try again later.", "error");
        });
      }
    }

    audio.addEventListener("ended", stopAudio);

    playBtn.addEventListener("click", function () {
      if (previewUrl) togglePlay(previewUrl, playBtn);
    });

    // Entre los resultados busca el que sea de ese artista y tenga ese título.
    // La búsqueda también puede devolver covers o canciones de nombre parecido.
    function findSong(results, song, artist) {
      var s = song.toLowerCase();
      var a = artist.toLowerCase();
      for (var i = 0; i < results.length; i++) {
        var item = results[i];
        if (!item.trackName || !item.artistName) continue;
        if (item.artistName.toLowerCase().indexOf(a) !== -1 &&
            item.trackName.toLowerCase().indexOf(s) !== -1) {
          return item;
        }
      }
      return null;
    }

    // Título, artista y link salen de la lista de datos: se ven aunque falle la API.
    function showInfo(pick) {
      label.textContent = "The song of " + pick.getAttribute("data-name");
      songEl.textContent = pick.getAttribute("data-song");
      artistEl.textContent = pick.getAttribute("data-artist");
      link.href = "#" + pick.getAttribute("data-project") + "-title";
      linkName.textContent = pick.getAttribute("data-name");
    }

    function hideMedia() {
      cover.hidden = true;
      cover.removeAttribute("src");
      playBtn.hidden = true;
      previewUrl = null;
    }

    function showSong(item) {
      if (!item) {
        setStatus("This song isn't available right now.", "empty");
        return;
      }
      if (item.artworkUrl100) {
        cover.src = item.artworkUrl100.replace("100x100", "400x400");
        cover.alt = "Cover of " + (item.collectionName || item.trackName);
        cover.hidden = false;
      }
      if (!item.previewUrl) {
        setStatus("There's no preview for this song.", "empty");
        return;
      }
      previewUrl = item.previewUrl;
      playBtn.setAttribute("aria-label", "Play preview of " + item.trackName);
      playBtn.hidden = false;
      setStatus("", "ready");
    }

    function setActive(index) {
      for (var i = 0; i < picks.length; i++) {
        picks[i].setAttribute("aria-pressed", i === index ? "true" : "false");
      }
    }

    function load(index) {
      var pick = picks[index];
      var song = pick.getAttribute("data-song");
      var artist = pick.getAttribute("data-artist");
      var myToken = ++token;

      stopAudio();
      setActive(index);
      showInfo(pick);
      hideMedia();

      // "in" y no cache[index]: si la canción no se encontró, en la cache queda null
      if (index in cache) {
        showSong(cache[index]);
        return;
      }

      setStatus("Loading…", "loading");

      var url =
        "https://itunes.apple.com/search?term=" + encodeURIComponent(song + " " + artist) +
        "&entity=song&limit=10";

      fetch(url)
        .then(function (res) {
          if (!res.ok) {
            var err = new Error("HTTP " + res.status);
            err.status = res.status;
            throw err;
          }
          return res.json();
        })
        .then(function (data) {
          if (myToken !== token) return; // el usuario ya eligió otro track
          var item = findSong(data.results || [], song, artist);
          cache[index] = item;
          showSong(item);
        })
        .catch(function (err) {
          if (myToken !== token) return;
          if (err && (err.status === 429 || err.status === 403)) {
            setStatus("Too many requests right now. Wait a minute and pick the track again.", "error");
          } else {
            setStatus("Couldn't load the song. Check your connection and pick the track again.", "error");
          }
        });
    }

    for (var i = 0; i < picks.length; i++) {
      picks[i].addEventListener("click", function (e) {
        load(Number(e.currentTarget.getAttribute("data-index")));
      });
    }

    load(0);
  })();
</script>
