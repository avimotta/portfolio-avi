---
const { title = "On repeat", artists = [] } = Astro.props;
---
<section class="s-repeat" aria-labelledby="repeat-title" data-repeat>
  <h2 class="h-section" id="repeat-title">{title}</h2>
  <p class="repeat-intro">Pick an artist and press play for a 30-second preview.</p>
 
  <div class="repeat-chips" role="group" aria-label="Choose an artist">
    {artists.map((name: string) => (
      <button type="button" class="repeat-chip" data-artist={name} aria-pressed="false">{name}</button>
    ))}
  </div>
 
  <p class="repeat-status" role="status" aria-live="polite"></p>
  <ul class="repeat-grid"></ul>
 
  <p class="repeat-credit">Music data and previews: iTunes Search API (Apple).</p>
</section>
 
<style is:global>
  /* ── Escritorio: la sección ocupa su propio tramo del lienzo ── */
  .s-repeat {
    position: absolute;
    top: calc(4889 * var(--u));
    left: 0;
    width: 100%;
    height: calc(1100 * var(--u));
    box-sizing: border-box;
    padding: calc(60 * var(--u)) calc(100 * var(--u)) 0;
    background: var(--lavender);
    color: var(--ink);
    text-align: center;
    z-index: 2;
  }
 
  .s-repeat .h-section { margin: 0; line-height: 1.2; }
 
  .repeat-intro {
    margin: calc(12 * var(--u)) 0 0;
    font-size: calc(18 * var(--u));
    line-height: 1.4;
  }
 
  .repeat-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(12 * var(--u));
    margin-top: calc(22 * var(--u));
  }
 
  .repeat-chip {
    font-family: var(--sans);
    font-size: calc(20 * var(--u));
    padding: calc(10 * var(--u)) calc(24 * var(--u));
    border: 2px solid var(--indigo);
    border-radius: 999px;
    background: var(--cream);
    color: var(--indigo);
    cursor: pointer;
  }
 
  .repeat-chip[aria-pressed="true"] {
    background: var(--indigo);
    color: var(--cream);
  }
 
  .repeat-chip:focus-visible,
  .repeat-play:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
 
  .repeat-status {
    min-height: calc(30 * var(--u));
    margin: calc(18 * var(--u)) 0;
    font-size: calc(18 * var(--u));
    line-height: 1.4;
  }
 
  .repeat-status[data-state="error"] { color: #9B2C4A; font-weight: 600; }
 
  .repeat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(24 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
 
  .repeat-cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(14 * var(--u));
    background: var(--cream);
  }
 
  .repeat-cover img { width: 100%; height: 100%; object-fit: cover; }
 
  .repeat-play {
    position: absolute;
    right: calc(12 * var(--u));
    bottom: calc(12 * var(--u));
    width: calc(52 * var(--u));
    height: calc(52 * var(--u));
    border: 0;
    border-radius: 50%;
    background: var(--cream);
    color: var(--indigo);
    font-size: calc(20 * var(--u));
    cursor: pointer;
  }
 
  .repeat-play[aria-pressed="true"] {
    background: var(--indigo);
    color: var(--cream);
  }
 
  .repeat-track {
    margin: calc(10 * var(--u)) 0 0;
    font-size: calc(17 * var(--u));
    font-weight: 600;
    line-height: 1.3;
  }
 
  .repeat-meta {
    margin: calc(2 * var(--u)) 0 0;
    font-size: calc(14 * var(--u));
    line-height: 1.3;
    color: var(--indigo);
  }
 
  .repeat-credit {
    margin: calc(28 * var(--u)) 0 0;
    font-size: calc(15 * var(--u));
  }
 
  /* ── Celular: columna normal, dos tarjetas por fila ── */
  @media (max-width: 899px) {
    .s-repeat {
      position: static;
      height: auto;
      padding: 56px 20px;
    }
    .repeat-intro { font-size: 15px; margin-top: 10px; }
    .repeat-chips { gap: 8px; margin-top: 16px; }
    .repeat-chip { font-size: 16px; padding: 10px 18px; }
    .repeat-status { font-size: 15px; min-height: 24px; margin: 16px 0; }
    .repeat-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .repeat-cover { border-radius: 12px; }
    .repeat-play { width: 44px; height: 44px; right: 8px; bottom: 8px; font-size: 16px; }
    .repeat-track { font-size: 15px; margin-top: 8px; }
    .repeat-meta { font-size: 13px; }
    .repeat-credit { font-size: 12px; margin-top: 24px; }
  }
</style>
 
<script is:inline>
  (function () {
    "use strict";
 
    var root = document.querySelector("[data-repeat]");
    if (!root) return;
 
    var chips = root.querySelectorAll(".repeat-chip");
    var status = root.querySelector(".repeat-status");
    var grid = root.querySelector(".repeat-grid");
 
    var audio = new Audio();
    var playingBtn = null;
    var cache = {};   // resultados ya pedidos: evita repetir pedidos (la API limita ~20 por minuto)
    var token = 0;    // identifica el último pedido, para ignorar respuestas viejas
 
    var PLAY = "\u25B6\uFE0E";
    var PAUSE = "\u275A\u275A";
 
    function setStatus(text, state) {
      status.textContent = text;
      status.setAttribute("data-state", state);
    }
 
    function stopAudio() {
      audio.pause();
      if (playingBtn) {
        playingBtn.setAttribute("aria-pressed", "false");
        playingBtn.textContent = PLAY;
      }
      playingBtn = null;
    }
 
    function togglePlay(url, btn) {
      if (playingBtn === btn) {
        stopAudio();
        return;
      }
      stopAudio();
      audio.src = url;
      playingBtn = btn;
      btn.setAttribute("aria-pressed", "true");
      btn.textContent = PAUSE;
      var p = audio.play();
      if (p && p.catch) {
        p.catch(function () {
          stopAudio();
          setStatus("Couldn't play this preview. Try another one.", "error");
        });
      }
    }
 
    audio.addEventListener("ended", stopAudio);
 
    // Se queda con canciones únicas que tengan lo mínimo para mostrarse.
    function clean(results) {
      var seen = {};
      var out = [];
      for (var i = 0; i < results.length; i++) {
        var item = results[i];
        if (!item.trackName) continue;
        var key = item.trackName.toLowerCase();
        if (seen[key]) continue;
        seen[key] = true;
        out.push(item);
        if (out.length === 6) break;
      }
      return out;
    }
 
    function buildCard(item) {
      var li = document.createElement("li");
 
      var cover = document.createElement("div");
      cover.className = "repeat-cover";
 
      if (item.artworkUrl100) {
        var img = document.createElement("img");
        img.src = item.artworkUrl100.replace("100x100", "400x400");
        img.alt = "Cover of " + (item.collectionName || item.trackName);
        img.width = 400;
        img.height = 400;
        img.loading = "lazy";
        cover.appendChild(img);
      }
 
      if (item.previewUrl) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "repeat-play";
        btn.setAttribute("aria-label", "Play preview of " + item.trackName);
        btn.setAttribute("aria-pressed", "false");
        btn.textContent = PLAY;
        btn.addEventListener("click", function () {
          togglePlay(item.previewUrl, btn);
        });
        cover.appendChild(btn);
      }
 
      var track = document.createElement("p");
      track.className = "repeat-track";
      track.textContent = item.trackName;
 
      var meta = document.createElement("p");
      meta.className = "repeat-meta";
      meta.textContent = item.collectionName || item.artistName;
 
      li.appendChild(cover);
      li.appendChild(track);
      li.appendChild(meta);
      return li;
    }
 
    function render(items) {
      grid.innerHTML = "";
      if (!items.length) {
        setStatus("No songs found for this artist.", "empty");
        return;
      }
      setStatus("", "ready");
      for (var i = 0; i < items.length; i++) {
        grid.appendChild(buildCard(items[i]));
      }
    }
 
    function setActive(name) {
      for (var i = 0; i < chips.length; i++) {
        var on = chips[i].getAttribute("data-artist") === name;
        chips[i].setAttribute("aria-pressed", on ? "true" : "false");
      }
    }
 
    function load(artist) {
      var myToken = ++token;
      stopAudio();
      setActive(artist);
      grid.innerHTML = "";
 
      if (cache[artist]) {
        render(cache[artist]);
        return;
      }
 
      setStatus("Loading\u2026", "loading");
 
      var url =
        "https://itunes.apple.com/search?term=" + encodeURIComponent(artist) +
        "&entity=song&attribute=artistTerm&limit=25";
 
      fetch(url)
        .then(function (res) {
          if (!res.ok) {
            var err = new Error("HTTP " + res.status);
            err.status = res.status;
            throw err;
          }
          return res.json();
        })
        .then(function (data) {
          if (myToken !== token) return; // el usuario ya eligió otro artista
          var items = clean(data.results || []);
          cache[artist] = items;
          render(items);
        })
        .catch(function (err) {
          if (myToken !== token) return;
          if (err && (err.status === 429 || err.status === 403)) {
            setStatus("Too many requests right now. Wait a minute and tap the artist again.", "error");
          } else {
            setStatus("Couldn't load the music. Check your connection and tap the artist again.", "error");
          }
        });
    }
 
    for (var i = 0; i < chips.length; i++) {
      chips[i].addEventListener("click", function (e) {
        load(e.currentTarget.getAttribute("data-artist"));
      });
    }
 
    if (chips.length) load(chips[0].getAttribute("data-artist"));
  })();
</script>