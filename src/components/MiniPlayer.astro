---
// Mini reproductor fijo abajo de la pantalla.
// No tiene audio propio: controla el mismo audio que la playlist de On repeat
// (window.portfolioPlayer). La canción la elige el usuario en la playlist y
// sigue sonando mientras recorre el resto del portfolio.
// Aparece cuando On repeat sale de la pantalla (si ya se pasó por la playlist
// o si hay algo sonando) y se esconde cuando On repeat está a la vista, porque
// ahí ya está el disco grande.
---
<section class="mini-player" aria-label="Music player" data-mini hidden>
  <div class="mini-progress" aria-hidden="true"><span class="mini-progress-fill"></span></div>

  <a class="mini-track" href="#repeat-title" aria-label="Back to the playlist">
    <span class="mini-cover"><img alt="" width="400" height="400" hidden></span>
    <span class="mini-text">
      <span class="mini-title"></span>
      <span class="mini-artist"></span>
    </span>
  </a>

  <span class="mini-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

  <div class="mini-controls">
    <button type="button" class="mini-btn mini-prev" aria-label="Previous track">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg>
    </button>
    <button type="button" class="mini-btn mini-play" aria-pressed="false" aria-label="Play">
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L20 12z"/></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5h4.5v15H6zM13.5 4.5H18v15h-4.5z"/></svg>
    </button>
    <button type="button" class="mini-btn mini-next" aria-label="Next track">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg>
    </button>
  </div>
</section>

<style is:global>
  .mini-player {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
    z-index: 25;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 14px;
    width: min(440px, calc(100% - 24px));
    padding: 8px 10px 10px 8px;
    border-radius: 20px;
    background: #FFF2DEE6;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 6px 24px #2F2B5333;
    color: var(--ink);
    font-family: var(--sans);
    overflow: hidden;
    translate: -50% 0; /* centrado; Motion anima transform, así no se pisan */
  }

  .mini-player[hidden] { display: none; }

  /* avance del preview de 30 segundos, arriba de todo, de borde a borde */
  .mini-progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: #495D9426;
  }

  .mini-progress-fill {
    display: block;
    height: 100%;
    background: var(--indigo);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* carátula + texto: es un link que vuelve a la playlist */
  .mini-track {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
  }

  /* la carátula es un vinilo chico, igual que el disco de On repeat */
  .mini-cover {
    position: relative;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--indigo);
    overflow: hidden;
  }

  .mini-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .mini-cover img[hidden] { display: none; }

  /* agujero del centro del vinilo */
  .mini-cover::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: 0 0 0 2px #2F2B5340;
  }

  .mini-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .mini-title,
  .mini-artist {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mini-title { font-size: 15px; font-weight: 600; }
  .mini-artist { font-size: 13px; color: #2F2B53CC; }

  /* ecualizador: cuatro barritas que Motion mueve mientras suena */
  .mini-eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 18px;
  }

  .mini-eq i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--indigo);
    transform: scaleY(0.25);
    transform-origin: bottom center;
  }

  .mini-controls { display: flex; align-items: center; gap: 2px; }

  .mini-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .mini-btn svg { width: 20px; height: 20px; fill: currentColor; }
  .mini-btn:hover { background: #D4DCFF; }
  .mini-btn:disabled { opacity: 0.4; cursor: default; background: transparent; }

  .mini-play { width: 44px; height: 44px; background: var(--indigo); color: var(--cream); }
  .mini-play:hover { background: var(--ink); }
  .mini-play .icon-pause,
  .mini-play[aria-pressed="true"] .icon-play { display: none; }
  .mini-play[aria-pressed="true"] .icon-pause { display: block; }

  .mini-btn:focus-visible,
  .mini-track:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* en celular, sin ecualizador para que entre el título */
  @media (max-width: 480px) {
    .mini-player { gap: 8px; }
    .mini-eq { display: none; }
    .mini-player { grid-template-columns: minmax(0, 1fr) auto; }
  }
</style>

<script>
  import { animate } from "motion";

  const el = document.querySelector("[data-mini]");
  const repeat = document.querySelector(".s-repeat");
  const player = window.portfolioPlayer;

  if (el && repeat && player) init();

  function init() {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const EASE = [0.22, 0.61, 0.36, 1];

    const playBtn = el.querySelector(".mini-play");
    const prevBtn = el.querySelector(".mini-prev");
    const nextBtn = el.querySelector(".mini-next");
    const cover = el.querySelector(".mini-cover img");
    const titleEl = el.querySelector(".mini-title");
    const artistEl = el.querySelector(".mini-artist");
    const text = el.querySelector(".mini-text");
    const fill = el.querySelector(".mini-progress-fill");
    const bars = Array.from(el.querySelectorAll(".mini-eq i"));

    let shown = false;
    let repeatVisible = true;
    let passedRepeat = false; // ya se bajó más allá de la playlist
    let everPlayed = false;
    let lastIndex = null;
    let lastCover = null;

    /* ── Controles: usan el mismo audio que la playlist ── */
    playBtn.addEventListener("click", () => player.toggle());
    prevBtn.addEventListener("click", () => player.prev());
    nextBtn.addEventListener("click", () => player.next());

    /* ── El vinilo gira mientras suena (Motion). Al cambiar de track arranca derecho. ── */
    let spin = null;
    function resetSpin() {
      if (spin) spin.cancel();
      spin = null;
      if (reduced) return;
      spin = animate(cover, { rotate: [0, 360] }, { duration: 6, repeat: Infinity, ease: "linear" });
      spin.pause();
    }

    /* ── Ecualizador: cada barra sube y baja a su ritmo mientras suena ── */
    //    Se crean al dar play y se frenan al pausar (las barras bajan suave).
    let eq = [];

    function setPlayingVisuals(on) {
      if (on) {
        if (spin) spin.play();
        if (!reduced && !eq.length) {
          eq = bars.map((bar, i) =>
            animate(
              bar,
              { scaleY: [0.25, 1, 0.45, 0.85, 0.25] },
              { duration: 0.9 + i * 0.17, repeat: Infinity, ease: "easeInOut" }
            )
          );
        }
      } else {
        if (spin) spin.pause();
        if (eq.length) {
          eq.forEach((a) => a.stop());
          eq = [];
          animate(bars, { scaleY: 0.25 }, { duration: 0.3 });
        }
      }
    }

    /* ── Avance del preview ── */
    player.audio.addEventListener("timeupdate", () => {
      const a = player.audio;
      const p = a.duration ? a.currentTime / a.duration : 0;
      fill.style.transform = `scaleX(${p})`;
    });

    /* ── Mostrar u ocultar: entra deslizándose desde abajo ── */
    function setShown(next) {
      if (next === shown) return;
      shown = next;
      if (next) {
        el.hidden = false;
        if (!reduced) animate(el, { y: [90, 0], opacity: [0, 1] }, { duration: 0.5, ease: EASE });
      } else if (reduced) {
        el.hidden = true;
      } else {
        animate(el, { y: 90, opacity: 0 }, { duration: 0.3, ease: "easeIn" }).then(() => {
          if (!shown) el.hidden = true; // si mientras tanto se volvió a mostrar, no lo esconde
        });
      }
    }

    function updateVisibility() {
      setShown(!repeatVisible && (passedRepeat || everPlayed));
    }

    // On repeat está en flujo normal (no tiene display: contents), así que se puede observar.
    // El margen hace que una franjita de la sección en el borde no cuente como "a la vista".
    new IntersectionObserver(
      ([entry]) => {
        repeatVisible = entry.isIntersecting;
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) passedRepeat = true;
        if (!entry.isIntersecting && entry.boundingClientRect.top > 0) passedRepeat = false;
        updateVisibility();
      },
      { rootMargin: "-15% 0px -15% 0px" }
    ).observe(repeat);

    /* ── Cada vez que cambia algo en la playlist o en el audio ── */
    function render(state) {
      if (!state) return;

      const changedTrack = state.index !== lastIndex;
      titleEl.textContent = state.song;
      artistEl.textContent =
        state.statusState === "empty" || state.statusState === "error"
          ? `${state.artist} · no preview`
          : state.artist;

      if (state.cover !== lastCover) {
        lastCover = state.cover;
        if (state.cover) {
          cover.src = state.cover;
          cover.hidden = false;
        } else {
          cover.hidden = true;
          cover.removeAttribute("src");
        }
      }

      if (changedTrack) {
        lastIndex = state.index;
        fill.style.transform = "scaleX(0)";
        resetSpin();
        // el título y la carátula nuevos entran, como en la playlist
        if (shown && !reduced) {
          animate(text, { opacity: [0, 1], y: [10, 0] }, { duration: 0.4, ease: EASE });
          animate(".mini-cover", { scale: [0.7, 1], opacity: [0, 1] }, { duration: 0.45, ease: EASE });
        }
      }

      playBtn.disabled = !state.canPlay;
      playBtn.setAttribute("aria-pressed", state.playing ? "true" : "false");
      playBtn.setAttribute(
        "aria-label",
        (state.playing ? "Pause " : "Play ") + state.song + " by " + state.artist
      );

      if (state.playing) everPlayed = true;
      setPlayingVisuals(state.playing);
      updateVisibility();
    }

    document.addEventListener("player:update", (e) => render(e.detail));
    resetSpin();
    render(player.state);
  }
</script>
