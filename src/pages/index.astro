---
import ProjectSection from "../components/ProjectSection.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import OnRepeat from "../components/OnRepeat.astro";
import { projects } from "../data/projects.js";
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Avi Motta — UX Artist</title>
<meta name="description" content="Portfolio of Avi Motta, UX Artist. Interface design, visual identity and digital products.">
<meta name="theme-color" content="#D4DCFF">
<link rel="icon" href="data:,">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Playfair+Display:wght@400..900&display=swap">
<link rel="stylesheet" href="css/style.css">
</head>

<body>
<main class="page" style="--page-h:6824; --shift:1100">

  <!-- ══════════ FONDOS (bandas de color) ══════════
       Secuencia de color base del original. El hero tiene alfa decreciente en
       su base, por eso la lavanda empieza en 560 y se ve a través de la foto.
       Desde el proyecto 1, bandas y degradados están 1100 más abajo que en el
       original (--shift): la primera lavanda se estira para cubrir On repeat. -->
  <div class="band" style="--by:560;  --bh:2780; --bg:#D4DCFF" aria-hidden="true"></div>
  <div class="band" style="--by:3340; --bh:1100; --bg:#FFF2DE" aria-hidden="true"></div>
  <div class="band" style="--by:4440; --bh:1549; --bg:#D4DCFF" aria-hidden="true"></div>
  <div class="band" style="--by:5989; --bh:913;  --bg:#495D94" aria-hidden="true"></div>

  <!-- ══════════ DEGRADADOS DE TRANSICIÓN ══════════
       En el original son 5 SVG con viewBox 1302×456 (o 1280×355) escalados con
       preserveAspectRatio="xMidYMid meet": el degradado NO ocupa la caja entera,
       queda letterboxeado y centrado verticalmente. De ahí --gy (offset) y --gh
       (alto dibujado). Los valores son los stops exactos del SVG original. -->
  <div class="grad" aria-hidden="true" style="--x:-2;  --by:2165; --w:1026; --bh:355; --gy:35.2;  --gh:284.6;
       --g:linear-gradient(180deg,#D4DCFF 72.6%,#D4DCFF00 100%)"></div>

  <div class="grad" aria-hidden="true" style="--x:-2;  --by:3045; --w:1036; --bh:375; --gy:43.9;  --gh:287.3;
       --g:linear-gradient(180deg,#FFF2DE00 0%,#FFF2DE00 4.85%,#FFF2DE 54.6%,#FFF2DE 100%)"></div>

  <div class="grad" aria-hidden="true" style="--x:-14; --by:4040; --w:1059; --bh:456; --gy:42.5;  --gh:371;
       --g:linear-gradient(180deg,#FFF2DE 0.96%,#D4DCFF 89.9%)"></div>

  <div class="grad" aria-hidden="true" style="--x:-21; --by:4666; --w:1066; --bh:834; --gy:230.3; --gh:373.4;
       --g:linear-gradient(180deg,#D4DCFF 70.19%,#D4DCFF00 100%)"></div>

  <div class="grad" aria-hidden="true" style="--x:-14; --by:5580; --w:1066; --bh:456; --gy:41.3;  --gh:373.4;
       --g:linear-gradient(180deg,#D4DCFF00 0%,#D4DCFF 42.3%)"></div>

  <!-- ══════════ HERO ══════════ -->
  <Hero
  firstName="Avi"
  lastName="Motta"
  role="UX Artist"
  photo="assets/img/hero.png"
  photoAlt="Portrait of Avi Motta"
/>

  <!-- ══════════ ABOUT ══════════ -->
  <About
  title="About me"
  paragraphs={[
    "I’m a UX Artist focused on creating meaningful user experiences, going beyond “just a page.”",
    "I have advanced knowledge of tools such as Adobe Illustrator, Adobe Photoshop, Adobe Premiere, and Figma, which I use as my primary design toolkit.",
    "I’m also deeply interested in art and music, which strongly influence my creative approach.",
    "Keep scrolling and find my works!"
  ]}
/>

  <!-- ══════════ ON REPEAT ══════════ -->
  <OnRepeat
    title="On repeat"
    tracks={projects}
  />

  <!-- ══════════ PROYECTO 1 — UNIVERSITY STREAMING ══════════ -->
  <ProjectSection
  id="p1"
  class="s-p1"
  title="Web page for University’s streaming"
  titleStyle="--x:237;--y:1120;--w:549"
  bodyStyle="--x:174;--y:2120;--w:676"
  >
    <img class="w bleed" src="assets/img/streaming-bleed.png" alt="" aria-hidden="true"
        style="--x:-32;--y:1274;--w:1133;--h:866" width="915" height="699">

    <a class="w device device--a" href="https://www.behance.net/gallery/251283847/Landing-Page-for-university-streaming"
      target="_blank" rel="noopener noreferrer" style="--x:35;--y:1220;--w:728;--h:426"
      aria-label="View the University streaming project on Behance">
      <img class="device-shot" src="assets/img/streaming-screen-1.png" alt="Landing page for a university streaming platform, desktop view" width="1098" height="693">
      <img class="device-frame" src="assets/svg/frame-browser.svg" alt="" aria-hidden="true">
      <img class="device-base" src="assets/svg/base-728.svg" alt="" aria-hidden="true">
    </a>

    <p class="w hint" style="--x:775;--y:1320;--w:182;--h:80"><span>click the screens</span></p>
    <p class="w hint" style="--x:728;--y:1340;--w:182;--h:80"><span>and see!</span></p>
    <img class="w arrow" src="assets/img/arrow.png" alt="" aria-hidden="true"
        style="--x:685;--y:1347;--w:91;--h:33" width="180" height="65">

    <a class="w device device--b" href="https://www.behance.net/gallery/251283847/Landing-Page-for-university-streaming"
      target="_blank" rel="noopener noreferrer" style="--x:206;--y:1586;--w:775;--h:454"
      aria-label="View the University streaming project on Behance">
      <img class="device-shot" src="assets/img/streaming-screen-2.png" alt="University streaming platform, laptop view" width="1095" height="690">
      <img class="device-frame" src="assets/svg/frame-laptop.svg" alt="" aria-hidden="true">
      <img class="device-base" src="assets/svg/base-776.svg" alt="" aria-hidden="true">
    </a>

    <Fragment slot="body">
      <p>Web design for a university streaming platform focused on accessibility and content discovery.</p>
      <p>The layout prioritizes easy navigation and clear content hierarchy, allowing users to quickly find the needed information.</p>
    </Fragment>
  </ProjectSection>

  <!-- ══════════ PROYECTO 2 — RANKING MUSIC APP ══════════ -->
  <ProjectSection
  id="p2"
  class="s-p2"
  title="Ranking music app"
  titleStyle="--x:237;--y:2320;--w:549"
  bodyStyle="--x:174;--y:2920;--w:676"
  >
    <div class="phones">
      <a class="w phone" href="https://www.behance.net/gallery/234674487/Manual-de-marca-Jukebox"
        target="_blank" rel="noopener noreferrer" style="--x:197.5;--y:2420;--w:201;--h:420"
        aria-label="View the Jukebox music app project on Behance">
        <img src="assets/img/music-1.png" alt="Ranking music app, screen 1" width="366" height="765">
      </a>
      <a class="w phone" href="https://www.behance.net/gallery/234674487/Manual-de-marca-Jukebox"
        target="_blank" rel="noopener noreferrer" style="--x:410.5;--y:2420;--w:201;--h:420"
        aria-label="View the Jukebox music app project on Behance">
        <img src="assets/img/music-2.png" alt="Ranking music app, screen 2" width="366" height="765">
      </a>
      <a class="w phone" href="https://www.behance.net/gallery/234674487/Manual-de-marca-Jukebox"
        target="_blank" rel="noopener noreferrer" style="--x:624.5;--y:2420;--w:201;--h:420"
        aria-label="View the Jukebox music app project on Behance">
        <img src="assets/img/music-3.png" alt="Ranking music app, screen 3" width="366" height="765">
      </a>
    </div>

    <Fragment slot="body">
      <p>Group project focused on creating a platform for emerging artists to showcase their work and connect with audiences. The design prioritizes intuitive navigation and content discovery, encouraging user engagement through community-driven features and a more personalized listening experience.</p>
    </Fragment>
  </ProjectSection>

  <!-- ══════════ PROYECTO 3 — EMERGING ARTIST ══════════ -->
  <ProjectSection
    id="p3"
    class="s-p3"
    title="Emerging Artist's Website"
    titleStyle="--x:236;--y:3114;--w:549"
    bodyStyle="--x:174;--y:3740;--w:676"
  >
    <img class="w shot" src="assets/img/artist.png" alt="Emerging artist website, main view" width="957" height="612"
        style="--x:169;--y:3220;--w:685;--h:438">

    <Fragment slot="body">
      <p>Web design for an emerging artist, focused on building a strong visual identity and digital presence. The layout highlights the artist’s work through clear hierarchy and immersive visuals, creating a more engaging and intuitive experience for users.</p>
    </Fragment>
  </ProjectSection>

  <!-- ══════════ PROYECTO 4 — TAYLOR SWIFT MERCH ══════════ -->
  <ProjectSection
    id="p4"
    class="s-p4"
    title="Taylor Swift Merch Landing Page"
    titleStyle="--x:234;--y:3954;--w:549"
    bodyStyle="--x:174;--y:4780;--w:676"
  >
    <img class="w bleed" src="assets/img/merch-bleed.png" alt="" aria-hidden="true"
        style="--x:-14;--y:3841;--w:1062;--h:899" width="1280" height="1084">

    <a class="w shot" href="https://www.behance.net/gallery/234673811/folklore-landing-page"
      target="_blank" rel="noopener noreferrer" style="--x:67;--y:4060;--w:609;--h:369"
      aria-label="View the folklore landing page on Behance">
      <img src="assets/img/merch-1.png" alt="Taylor Swift merch landing page, screen 1" width="705" height="427">
    </a>

    <img class="w shot" src="assets/img/merch-2.png" alt="Taylor Swift merch landing page, screen 2" width="776" height="450"
        style="--x:353;--y:4350;--w:604;--h:350">

    <Fragment slot="body">
      <p>Concept landing page focused on showcasing merchandise in a clear and engaging way.</p>
      <p>The design prioritizes visual hierarchy and intuitive navigation, helping users quickly explore products and encouraging conversion through strategic call-to-actions.</p>
    </Fragment>
  </ProjectSection>

  <!-- ══════════ CONTACTO ══════════ -->
  <Contact
  title="CONTACT ME"
  email="avrilmotta@gmail.com"
  links={[
    { label: "Behance", href: "https://www.behance.net/avimotta" },
    { label: "Linkedin", href: "https://www.linkedin.com/in/avril-victoria-motta-marcos-214318252/" }
  ]}
/>


</main>

<script is:inline src="/js/main.js" defer></script>
</body>
</html>
